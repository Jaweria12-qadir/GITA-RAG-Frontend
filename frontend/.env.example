# GITA RAG frontend — Milestone 5 backend connection
#
# Leave VITE_API_BASE_URL empty to keep using mock responses.
# When your backend is running, set the base URL (no trailing slash).

VITE_API_BASE_URL=http://localhost:8000

# Ask endpoint path (combined with base URL → http://localhost:8000/ask)
VITE_API_ASK_PATH=/ask

# Set to true to force mock mode even if a base URL is present
VITE_USE_MOCK=false
